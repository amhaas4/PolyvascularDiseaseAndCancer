%MACRO MKT_PULL_CODES(START_YEAR, END_YEAR, OUTFILE, TEST=Y, LIBTEMP = WORK);



/* Internal Macro that actually does the work of pulling the codes for each year */
%MACRO MKT_PULL_INTERNAL(YEAR,TEST_INNER=Y);

%IF &TEST_INNER = N %THEN %DO;
	%LET OPTIONS =    ;
%END;
%ELSE %DO ;
	%LET OPTIONS = (OBS = 5000);
%END;


%LET DSLIST_CCAE = TEMP;
%LET DSLIST_MDCR = TEMP;

%MACRO DATA_NAMER(LIBNAME,SETNAME,OPTIONS,NAME);

Proc SQL noprint;
	Select cats("&LIBNAME..",memname)||" &OPTIONS"
	into :&NAME separated by ' '
	from dictionary.tables
	where libname = upcase("&LIBNAME") AND SUBSTR(MEMNAME,1,LENGTH("&SETNAME")) = "&SETNAME";
Quit;

%MEND;


%MACRO PARSE(VAR_TEST,PREF,N_VAR);
	%LET WORD_COUNT = %SYSFUNC(COUNTW(&VAR_TEST));
	%DO I = 1 %TO &WORD_COUNT;
		%GLOBAL &PREF.&I;
		%LET &PREF.&I = %SCAN(&VAR_TEST,&I);
	%END;
	%GLOBAL &N_VAR;
	%LET &N_VAR = &WORD_COUNT;
%MEND;

%MACRO EX_NUM(PREF,N_VAR);
	%LET STARTNUM = %EVAL(%LENGTH(&PREF) + 2);
	%LET MID = _NUM_; 
	%DO I = 1 %TO &N_VAR;
		%GLOBAL &PREF._NUM_&I;
		%LET &PREF._NUM_&I = %SUBSTR(&&&PREF&I,&STARTNUM,1);
		%GLOBAL &PREF._CLASS_&I;
		%LET &PREF._CLASS_&I = %SUBSTR(&&&PREF&I,%EVAL(&STARTNUM + 2));
	%END;
%MEND;

%MACRO REPEATER(NRDG, NRPR, PDXNUM = -1, PPRNUM = -1);
	

	%LET MID1 = _NUM_;
	%LET MID2 = _CLASS_;

	IF DATE LE '30SEP2015'D THEN DO;

		DO I = 1 TO &NRDG;
			
			%DO N = 1 %to &NUM_DIAG9;
				%LET TEMP = &&DIAG9&N;
				IF SUBSTR(DGNS[i],1,&&DIAG9&MID1&N) IN &&&TEMP THEN DO;
					TYPE = 'D';
					POSITION = PUT(I,8.);
					CODE = DGNS[i];
					CLASS = "&&DIAG9&MID2&N";
					IF I = &PDXNUM THEN POSITION = 'P';
					OUTPUT;
				END;
			%END;
		END;



		DO I = 1 TO &NRPR;

			%DO N = 1 %TO &NUM_PROC9;
				%LET TEMP = &&PROC9&N;
				IF SUBSTR(PROC[i],1,&&PROC9&MID1&N) IN &&&TEMP AND LENGTH(PROC[I]) IN (3 4) THEN DO;
					TYPE = 'P';
					POSITION = PUT(I,8.);
					CODE = PROC[i];
					CLASS = "&&PROC9&MID2&N";
					IF I = &PPRNUM THEN POSITION = 'P';
					OUTPUT;
				End;
			%END;

			%DO N = 1 %TO &NUM_CPT;
				%LET TEMP = &&CPT&N;
				IF SUBSTR(PROC[i],1,&&CPT&MID1&N) IN &&&TEMP AND LENGTH(PROC[I]) = 5 THEN DO;
					TYPE = 'P';
					POSITION = PUT(I,8.);
					CODE = PROC[i];
					CLASS = "&&CPT&MID2&N";
					IF I = &PPRNUM THEN POSITION = 'P';
					OUTPUT;
				End;
			%END;
		END;

	End;

	IF DATE > '30SEP2015'D THEN DO;

		DO I = 1 TO &NRDG;

			%DO N = 1 %to &NUM_DIAG10;
				%LET TEMP = &&DIAG10&N; 
				IF SUBSTR(DGNS[i],1,&&DIAG10&MID1&N) IN &&&TEMP THEN DO;
					TYPE = 'D';
					POSITION = PUT(I,8.);
					CODE = DGNS[i];
					CLASS = "&&DIAG10&MID2&N";
					IF I = &PDXNUM THEN POSITION = 'P';
					OUTPUT;
				END;
			%END;
		END;

		TYPE = 'P';

		DO I = 1 TO &NRPR;
			%DO N = 1 %TO &NUM_PROC10;
				%LET TEMP = &&PROC10&N;
				IF SUBSTR(PROC[i],1,&&PROC10&MID1&N) IN &&&TEMP AND LENGTH(PROC[I]) IN (7) THEN DO;
					TYPE = 'P';
					POSITION = PUT(I,8.);
					CODE = PROC[i];
					CLASS = "&&PROC10&MID2&N";
					IF I = &PPRNUM THEN POSITION = 'P';
					OUTPUT;
				END;
			%END;

			%DO N = 1 %TO &NUM_CPT;
				%LET TEMP = &&CPT&N;
				IF SUBSTR(PROC[i],1,&&CPT&MID1&N) IN &&&TEMP AND LENGTH(PROC[I]) = 5 THEN DO;
					TYPE = 'P';
					POSITION = PUT(I,8.);
					CODE = PROC[i];
					CLASS = "&&CPT&MID2&N";
					IF I = &PPRNUM THEN POSITION = 'P';
					OUTPUT;
				END;
			%END;
		END; 
	End;


%MEND;



%PARSE(VAR_TEST = &DIAG9LIST,
			PREF = DIAG9,
			N_VAR = NUM_DIAG9);
%EX_NUM(DIAG9,&NUM_DIAG9);

%PARSE(VAR_TEST = &PROC9LIST,
			PREF = PROC9,
			N_VAR = NUM_PROC9);
%EX_NUM(PROC9,&NUM_PROC9);

%PARSE(VAR_TEST = &DIAG10LIST,
			PREF = DIAG10,
			N_VAR = NUM_DIAG10);
%EX_NUM(DIAG10,&NUM_DIAG10);

%PARSE(VAR_TEST = &PROC10LIST,
			PREF = PROC10,
			N_VAR = NUM_PROC10);
%EX_NUM(PROC10,&NUM_PROC10);

%PARSE(VAR_TEST = &CPTLIST,
			PREF = CPT,
			N_VAR = NUM_CPT);
%EX_NUM(CPT,&NUM_CPT);

DATA &LIBTEMP..DXA7X9B2QK_OUTPAT;
	SET &LIB_CCAE_O..CCAE_O_&YEAR &OPTIONS &LIB_MDCR_O..MDCR_O_&YEAR &OPTIONS;
		
	LENGTH DATE 8. CHECKDATE 8. CODE $10 CLASS $10 TYPE $1 PLACE $1 POSITION $2 SOURCE $1;

	KEEP  ENROLID DATE CODE CLASS TYPE PLACE POSITION SOURCE MSCLMID;

	SOURCE = 'O';
	
	ARRAY DGNS[4] DX1 - DX4;
	ARRAY PROC[1] PROC1;

	PLACE = 'O';
	DATE = SVCDATE;
	CHECKDATE = SVCDATE;

	
	%REPEATER(NRDG = 4, NRPR = 1, PDXNUM = -1, PPRNUM = -1);


Run;


PROC SORT DATA=&LIBTEMP..DXA7X9B2QK_OUTPAT NODUPKEY;
	BY enrolid class code date place position type source;
run;


DATA &LIBTEMP..DXA7X9B2QK_IS;
	SET &LIB_CCAE_S..CCAE_S_&YEAR &OPTIONS &LIB_MDCR_S..MDCR_S_&YEAR &OPTIONS;
		
	LENGTH DATE 8. CHECKDATE 8. CODE $10 CLASS $10 TYPE $1 PLACE $1 POSITION $2 SOURCE $1;

	KEEP  ENROLID DATE CODE CLASS TYPE PLACE POSITION  SOURCE;

	SOURCE = 'S';
	
	ARRAY DGNS[5] DX1 - DX4 PDX;
	ARRAY PROC[2] PROC1 PPROC;

	PLACE = 'I';
	DATE = ADMDATE;
	CHECKDATE = DISDATE;

	%LET MID1 = _NUM_;
	%LET MID2 = _CLASS_;

	%REPEATER(NRDG = 5, NRPR = 2, PDXNUM = 5, PPRNUM = 2);
Run;




PROC SORT DATA=&LIBTEMP..DXA7X9B2QK_IS NODUPKEY;
	BY enrolid class code date place position type source;
run;


DATA &LIBTEMP..DXA7X9B2QK_I;
	SET &LIB_CCAE_I..CCAE_I_&YEAR &OPTIONS &LIB_MDCR_I..MDCR_I_&YEAR &OPTIONS;
		
	LENGTH DATE 8. CHECKDATE 8. CODE $10 CLASS $10 TYPE $1 PLACE $1 POSITION $2 SOURCE $1;

	KEEP  ENROLID DATE CODE CLASS TYPE PLACE POSITION  SOURCE;

	SOURCE = 'I';
	
	ARRAY DGNS[16] DX1 - DX15 PDX;
	ARRAY PROC[16] PROC1 - PROC15 PPROC;

	PLACE = 'I';
	DATE = ADMDATE;
	CHECKDATE = DISDATE;

	%LET MID1 = _NUM_;
	%LET MID2 = _CLASS_;

	%REPEATER(NRDG = 16, NRPR = 16, PDXNUM = 16, PPRNUM = 16);
Run;


PROC SORT DATA=&LIBTEMP..DXA7X9B2QK_I NODUPKEY;
	BY enrolid class code date place position type source;
run;


DATA &LIBTEMP..DXA7X9B2QK_F;
	SET &LIB_CCAE_F..CCAE_F_&YEAR &OPTIONS &LIB_MDCR_F..MDCR_F_&YEAR &OPTIONS;
		
	LENGTH DATE 8. CHECKDATE 8. CODE $10 CLASS $10 TYPE $1 PLACE $1 POSITION $2 SOURCE $1;

	KEEP  ENROLID DATE CODE CLASS TYPE PLACE POSITION SOURCE;

	SOURCE = 'F';
	
	ARRAY DGNS[9] DX1 - DX9;
	ARRAY PROC[1] PROC1;

	DATE = SVCDATE;
	PLACE = 'I';
	CHECKDATE = SVCDATE;

	%LET MID1 = _NUM_;
	%LET MID2 = _CLASS_;

	%REPEATER(NRDG = 9, NRPR = 1, PDXNUM = -1, PPRNUM = -1);

Run;


PROC SORT DATA=&LIBTEMP..DXA7X9B2QK_F NODUPKEY;
	BY enrolid class code date place position type source;
run;



DATA &LIBTEMP..DXA7X9B2QK_ALL;
	SET &LIBTEMP..DXA7X9B2QK_I &LIBTEMP..DXA7X9B2QK_IS &LIBTEMP..DXA7X9B2QK_OUTPAT &LIBTEMP..DXA7X9B2QK_F;
	YEAR = &YEAR;
Run;



%MEND;

Proc DELETE DATA=&OUTFILE;
Run;


%DO JJ = &START_YEAR %TO &END_YEAR;
	%MKT_PULL_INTERNAL(YEAR = &JJ, TEST_INNER = &TEST);
	PROC APPEND BASE =  &OUTFILE DATA = &LIBTEMP..DXA7X9B2QK_ALL;
	Run;
%END;


%IF &TEST = Y %THEN %DO;
	TITLE TEST MODE IS ON.  RESULTS FOR 500 OBSERVATIONS PER DATA SET;
	TITLE2 RUN WITH TEST = N FOR FULL DATA;
%END;


PROC FREQ DATA=&OUTFILE;
	TABLES class place position type source YEAR;
Run;


%IF &TEST = Y %THEN %DO;
	TITLE ;
	TITLE2 ;
	%PUT WARNING:  TEST MODE IS ON.  RESULTS FOR 500 OBSERVATIONS PER DATA SET;
	%PUT WARNING:  RUN WITH TEST = N FOR FULL DATA;
%END;


%MEND;
