



%MACRO INDY_1_C(CLASS
		, START_RANGE
		, END_RANGE
		, DATA_IN
		, DATA_OUT
		, CODE_FILE
		, VAR_NAME_OUT
		, PATKEY
		, START_INC = 1
		, END_INC = 1);

%IF &START_INC = 1 %THEN %LET START_OPERATOR = LE;
%ELSE %LET START_OPERATOR = LT;

%IF &END_INC = 1 %THEN %LET END_OPERATOR = LE;
%ELSE %LET END_OPERATOR = LT;

PROC SQL;
	Create Table ZYNPVNQ1 as
		Select a.*, b.DATE as DATE_ZYNPVNQ
			From &DATA_IN as a
			Left Join &CODE_FILE as b
			ON a.&PATKEY = b.&PATKEY
				AND a.&START_RANGE &START_OPERATOR b.DATE &END_OPERATOR a.&END_RANGE
				AND b.CLASS = "&CLASS";
Quit;

Proc Sort DATA = ZYNPVNQ1;
	BY &PATKEY DATE_ZYNPVNQ;
Run;

DATA &DATA_OUT;
	SET ZYNPVNQ1;
	BY &PATKEY;
	IF FIRST.&PATKEY;
	
	IF DATE_ZYNPVNQ NE . THEN &VAR_NAME_OUT = 1;
	ELSE &VAR_NAME_OUT = 0;

	Label &VAR_NAME_OUT = "Indicator for &CLASS in &START_RANGE &START_OPERATOR Date &END_OPERATOR &END_RANGE, 1 Code Definition";
	drop DATE_ZYNPVNQ;
Run;

Proc Freq data=&DATA_OUT;
	Tables &VAR_NAME_OUT;
Run;

%MEND;