
/* Macro for Making Indicator variables, 2 OP, 1 IP, 1 Procedure Definition */


/* Macro to add var to add var */
%MACRO INDY_2_1(CLASS, START_RANGE, END_RANGE, DATA_IN, DATA_OUT, CODE_FILE, VAR_NAME_OUT, PATKEY, START_INC = 1, END_INC = 1);

%IF &START_INC = 1 %THEN %LET START_OPERATOR = LE;
%ELSE %LET START_OPERATOR = LT;

%IF &END_INC = 1 %THEN %LET END_OPERATOR = LE;
%ELSE %LET END_OPERATOR = LT;



DATA QZZXYJQZ_TEST;
	SET &CODE_FILE;
	IF CLASS = "&CLASS";
Run;

Proc SQL;
	Create Table QZZXYJQZ as
		Select a.*, b.DATE as INP_PROC_DATE
			From &DATA_IN as a
			LEFT JOIN QZZXYJQZ_TEST as b
			ON a.&PATKEY = b.&PATKEY 
				AND a.&START_RANGE &START_OPERATOR b.DATE &END_OPERATOR a.&END_RANGE
				AND (b.TYPE = 'P' OR b.PLACE = 'I');
Quit;

Proc SORT data=QZZXYJQZ;
	By &PATKEY INP_PROC_DATE;
Run;

DATA QZZXYJQZ;
	Set QZZXYJQZ;
	BY &PATKEY;
	IF FIRST.&PATKEY;
Run;

Proc SQL;
	Create Table QZZXYJQZ2 as
		Select a.*, b.DATE as OP_DATE1
			From QZZXYJQZ as a
			LEFT JOIN QZZXYJQZ_TEST as b
			ON a.&PATKEY = b.&PATKEY 
				AND a.&START_RANGE &START_OPERATOR b.DATE &END_OPERATOR a.&END_RANGE
				AND (b.TYPE NE 'P' AND b.PLACE NE 'I');
Quit;


Proc SORT data=QZZXYJQZ2;
	By &PATKEY OP_DATE1;
Run;

DATA QZZXYJQZ2;
	Set QZZXYJQZ2;
	BY &PATKEY;
	IF FIRST.&PATKEY;
Run;

Proc SQL;
	Create Table QZZXYJQZ3 as
		Select a.*, b.DATE as OP_DATE2
			From QZZXYJQZ2 as a
			LEFT JOIN QZZXYJQZ_TEST as b
			ON a.&PATKEY = b.&PATKEY 
				AND a.&START_RANGE &START_OPERATOR b.DATE &END_OPERATOR a.&END_RANGE
				AND (b.TYPE NE 'P' AND b.PLACE NE 'I')
				AND b.DATE >= a.OP_DATE1 + 30;
Quit;


Proc SORT data=QZZXYJQZ3;
	By &PATKEY OP_DATE2;
Run;

DATA &DATA_OUT;
	Set QZZXYJQZ3;
	BY &PATKEY;
	IF FIRST.&PATKEY;

	IF INP_PROC_DATE NE . THEN &VAR_NAME_OUT = 1;
	IF OP_DATE1 NE . AND OP_DATE2 NE . THEN &VAR_NAME_OUT = 1;
	IF &VAR_NAME_OUT = . THEN &VAR_NAME_OUT = 0;

	Label &VAR_NAME_OUT = "Automatic Indicator for &CLASS in range &START_RANGE &START_OPERATOR DATE &END_OPERATOR &END_RANGE .  1 I/P, 2 OP Definition.";

	DROP INP_PROC_DATE OP_DATE1 OP_DATE2;
Run;


Proc freq data=&DATA_OUT;
	Tables &VAR_NAME_OUT;
run;

%MEND;