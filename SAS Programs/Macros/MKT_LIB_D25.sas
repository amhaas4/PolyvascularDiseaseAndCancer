%MACRO MKT_LIB_D25;

%PUT NOTE:  CREATES LIBNAMES FOR THE 2026 MARKETSCAN DATA.;
%PUT NOTE:  UNLIKE PREVIOUS VERSIONS, THIS DATA IS STORED IN INDIVIDUAL DIRECTORIES BY CLAIM TYPE IN ADDITION TO MEDICARE/COMMERCIAL.;
%PUT NOTE:  FOR EXAMPLE, THE OUTPATIENT COMMERCIAL CLAIMS ARE IN THE DIRECTORY CCAE_O.  THE LIBNAMES USE THE SAME SYSTEM.;

%LET CCAE_LOC = /rsrch9/hsr/hsrsrch/MKT-2009-2024/MKT-Dec2025/COMMERCIAL_SET_A/CCAE_;
%LET MDCR_LOC = /rsrch9/hsr/hsrsrch/MKT-2009-2024/MKT-Dec2025/MEDICARE_SET_A/MDCR_;

%LET N57QX1 = A;
%LET N57QX2 = D;
%LET N57QX3 = F;
%LET N57QX4 = I;
%LET N57QX5 = M;
%LET N57QX6 = O;
%LET N57QX7 = R;
%LET N57QX8 = S;
%LET N57QX9 = T;

%DO LIB_COUNT = 1 %TO 9;

	LIBNAME CCAE_&&N57QX&LIB_COUNT "&CCAE_LOC.&&N57QX&LIB_COUNT" ACCESS=READONLY;
	LIBNAME MDCR_&&N57QX&LIB_COUNT "&MDCR_LOC.&&N57QX&LIB_COUNT" ACCESS=READONLY;

	%GLOBAL LIB_CCAE_&&N57QX&LIB_COUNT;
	%GLOBAL LIB_MDCR_&&N57QX&LIB_COUNT;

	%LET LIB_CCAE_&&N57QX&LIB_COUNT = CCAE_&&N57QX&LIB_COUNT;
	%LET LIB_MDCR_&&N57QX&LIB_COUNT = MDCR_&&N57QX&LIB_COUNT;

%END;



%MEND;
