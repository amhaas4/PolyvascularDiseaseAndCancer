

%MACRO MKT_CODEBOOK_READER(CODEBOOK);

/* IMPORTS EXCEL FILE COODBOOK */
Proc Import datafile=&Codebook 
				out = XO7IVWPIWOWR 
				DBMS=XLSX 
				REPLACE;
Run;

/* SPINS EACH CODE TYPE INTO ITS OWN DATA SET */

DATA XO7IVWPIWOWRDIAG9 XO7IVWPIWOWRPROC9 XO7IVWPIWOWRDIAG10 XO7IVWPIWOWRPROC10 XO7IVWPIWOWRCPT;
	SET XO7IVWPIWOWR;
	CODE = UPCASE(STRIP(COMPRESS(CODE,".")));
	CLASS = UPCASE(CLASS);
	LENGTH = LENGTH(CODE);

	IF TYPE = 'ICD9DIAG' THEN OUTPUT  XO7IVWPIWOWRDIAG9;
	IF TYPE = 'ICD9PROC' THEN OUTPUT  XO7IVWPIWOWRPROC9;
	IF TYPE = 'ICD10DIAG' THEN OUTPUT XO7IVWPIWOWRDIAG10;
	IF TYPE = 'ICD10PROC' THEN OUTPUT XO7IVWPIWOWRPROC10;
	IF TYPE = 'CPT' THEN OUTPUT XO7IVWPIWOWRCPT;
RUN;


/* CREATES MACROVARIABLES FOR USE BY THE CODE PULLING MACRO */
/* IF THERE ARE NO CODES OF A SPECIFIC TYPE IT CREATES A DUMMY VARIABLE FOR THAT TYPE */

%MACRO SPLITTER(TYPE);

%GLOBAL &TYPE.LIST;
%LET &TYPE.LIST = &TYPE._5_NONE;

PROC SORT DATA=XO7IVWPIWOWR&TYPE;
	BY CLASS LENGTH;
RUN;

DATA _NULL_;
	SET XO7IVWPIWOWR&TYPE END = LAST;
	BY CLASS LENGTH;

	LENGTH CODELIST $10000.;
	LENGTH VARNAME $500.;
	LENGTH &TYPE.LIST $500.;
	RETAIN CODELIST &TYPE.LIST;

	IF FIRST.LENGTH THEN CODELIST = "(";
	
	CODELIST = STRIP(CODELIST)||STRIP("'")||STRIP(CODE)||STRIP("'");

	IF LAST.LENGTH THEN DO;
		CODELIST = STRIP(CODELIST)||STRIP(")");
		VARNAME =STRIP("&TYPE._")||STRIP(PUT(LENGTH,8.))||STRIP("_")||STRIP(CLASS);
		CALL SYMPUTX(VARNAME,STRIP(CODELIST),'G');
		&TYPE.LIST = STRIP(&TYPE.LIST)||"-"||STRIP(VARNAME);
	END;
	ELSE DO;
		CODELIST = STRIP(CODELIST)||STRIP(",");
	END;

	IF LAST THEN DO;
		&TYPE.LIST = TRANWRD(STRIP(&TYPE.LIST),"-"," ");
		CALL SYMPUTX("&TYPE.LIST",&TYPE.LIST,'G');
	eND;
RUN;


%IF &&&TYPE.LIST = &TYPE._5_NONE %THEN %DO;
%GLOBAL &TYPE._5_NONE;
%let &TYPE._5_NONE = ('ZZZZZZ');
%END;

%MEND;

%SPLITTER(PROC9);
%SPLITTER(DIAG9);
%SPLITTER(PROC10);
%SPLITTER(DIAG10);
%SPLITTER(CPT);


/* CREATES LIST OF MACRO VARIABLES CREATED */
data macro_vars;
     set SASHELP.VMACRO;
     where scope = 'GLOBAL';
     if substr(name, 1, 1) = '_' then delete;
     if substr(name, 1, 3) in ('SAS', 'SQL', 'SYS') then delete;
	 IF SUBSTR(NAME,1,3) IN ('CPT' 'PRO' 'DIA');

PROC PRINT DATA=MACRO_VARS; RUN;

%mend;